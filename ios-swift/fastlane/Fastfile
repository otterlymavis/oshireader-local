require "json"

default_platform(:ios)

# Absolute path to the `ios-swift/` directory (the folder that holds `fastlane/`).
IOS_PROJECT_DIR = File.expand_path("..", __dir__)

# Return { udid:, identifier: } for a single paired physical iPhone, or nil when
# the count is not exactly one (the lane then asks for an explicit `udid:`).
# `udid` is the hardware UDID that `xcodebuild -destination id=` expects;
# `identifier` is the CoreDevice id that `devicectl --device` expects.
def detect_connected_device
  raw = `xcrun devicectl list devices --json-output - 2>/dev/null`
  return nil if raw.strip.empty?
  devices = (JSON.parse(raw).dig("result", "devices") || []).select do |device|
    device.dig("connectionProperties", "pairingState") == "paired" &&
      device.dig("hardwareProperties", "platform") == "iOS" &&
      device.dig("hardwareProperties", "reality") == "physical"
  end
  return nil unless devices.length == 1
  { udid: devices.first.dig("hardwareProperties", "udid"),
    identifier: devices.first["identifier"] }
rescue JSON::ParserError
  nil
end

platform :ios do
  private_lane :paid_acceptance_build_number do
    configured = ENV.fetch("PAID_ACCEPTANCE_BUILD_NUMBER", "").strip
    if configured.empty?
      UI.user_error!("Set PAID_ACCEPTANCE_BUILD_NUMBER to a build number not already used in App Store Connect")
    end
    unless configured.match?(/\A[1-9]\d*\z/)
      UI.user_error!("PAID_ACCEPTANCE_BUILD_NUMBER must be a positive integer")
    end
    configured
  end

  private_lane :build_paid_acceptance do |options|
    catalog_path = File.expand_path("../config/paid-catalog.json", __dir__)
    catalog = JSON.parse(File.read(catalog_path))
    product_ids = catalog.fetch("products").map { |product| product.fetch("id") }.join(",")
    build_number = options[:build_number] || paid_acceptance_build_number

    build_app(
      project: "OshiReader.xcodeproj",
      scheme: "OshiReader Production",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build/paid-acceptance",
      output_name: "OshiReader-Paid-Acceptance.ipa",
      xcargs: "PUSH_SUBSCRIPTION_PRODUCT_IDS=#{product_ids} CURRENT_PROJECT_VERSION=#{build_number}"
    )
  end

  private_lane :app_store_connect_key do
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_CONNECT_KEY_PATH"]

    if key_id && !key_id.strip.empty? && issuer_id && key_filepath
      app_store_connect_api_key(
        key_id: key_id.strip,
        issuer_id: issuer_id.strip,
        key_filepath: key_filepath.strip
      )
    else
      nil
    end
  end

  desc "Upload OshiReader Local metadata to App Store Connect"
  lane :upload_metadata do
    deliver(
      api_key: app_store_connect_key,
      app_identifier: "com.otterpia.oshireader",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      automatic_release: false
    )
  end

  desc "Download OshiReader Local metadata from App Store Connect"
  lane :download_metadata do
    deliver(
      api_key: app_store_connect_key,
      app_identifier: "com.otterpia.oshireader",
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false
    )
  end

  desc <<~DESC
    Build the Debug app (OshiReader Local scheme) and install it on a connected
    iPhone so you can run a real StoreKit sandbox purchase against the hosted
    backend. Then, on the device: Settings -> Developer -> Sandbox Apple Account,
    sign in with an App Store Connect sandbox tester, and buy from the app's
    Settings -> Paid Backend screen.

      fastlane ios dev_device                 # auto-detects a single paired iPhone
      fastlane ios dev_device udid:<id>       # target a specific device
      fastlane ios dev_device launch:false    # install only, do not relaunch
  DESC
  lane :dev_device do |options|
    manual = (options[:udid] || ENV["DEV_DEVICE_UDID"]).to_s.strip
    if manual.empty?
      detected = detect_connected_device
      UI.user_error!(
        "No single paired iPhone found. Connect one device (USB, unlocked, " \
        "trusted), or pass udid:<id> (see `xcrun devicectl list devices`) or " \
        "set DEV_DEVICE_UDID."
      ) if detected.nil?
      build_id   = detected[:udid]        # xcodebuild -destination id=
      install_id = detected[:identifier]  # devicectl --device
    else
      # A manually supplied value is used verbatim for both tools.
      build_id = install_id = manual
    end
    UI.message("Target device: #{build_id}")

    # Reachability pre-flight: a device can be *paired* but not connected, which
    # otherwise surfaces only as a 60s xcodebuild "destination ... unavailable"
    # timeout ("developer disk image could not be mounted").
    `xcrun devicectl device info lockState --device #{install_id.shellescape} --timeout 10 2>&1`
    unless $?.success?
      UI.user_error!(
        "Device #{install_id} is paired but not reachable. Plug it in via USB, " \
        "unlock it, confirm the Trust prompt, then re-run."
      )
    end

    # Surface a signing-team mismatch before xcodebuild fails deep in signing.
    settings = `xcrun xcodebuild -project #{IOS_PROJECT_DIR.shellescape}/OshiReader.xcodeproj -scheme 'OshiReader Local' -showBuildSettings 2>/dev/null`
    team = settings[/\bDEVELOPMENT_TEAM = (\S+)/, 1]
    if team && !`security find-identity -p codesigning -v 2>/dev/null`.include?(team)
      UI.important(
        "No local codesigning identity for team #{team}. If the build fails at " \
        "signing, open Xcode > Settings > Accounts and add an Apple ID in that team."
      )
    end

    # Keep the generated project in sync with project.yml before building.
    sh("xcodegen", "generate",
       "--spec", "#{IOS_PROJECT_DIR}/project.yml",
       "--project", IOS_PROJECT_DIR)

    derived_data = "#{IOS_PROJECT_DIR}/build/dev-device"
    sh("xcodebuild",
       "-project", "#{IOS_PROJECT_DIR}/OshiReader.xcodeproj",
       "-scheme", "OshiReader Local",
       "-configuration", "Debug",
       "-destination", "id=#{build_id}",
       "-derivedDataPath", derived_data,
       "-allowProvisioningUpdates",
       "build")

    app_path = "#{derived_data}/Build/Products/Debug-iphoneos/OshiReader.app"
    UI.user_error!("Build product missing at #{app_path}") unless File.directory?(app_path)

    sh("xcrun", "devicectl", "device", "install", "app",
       "--device", install_id, app_path)

    unless options[:launch].to_s == "false"
      sh("xcrun", "devicectl", "device", "process", "launch",
         "--device", install_id, "--terminate-existing", "com.otterpia.oshireader")
    end

    UI.success("Installed on #{install_id}.")
    UI.message("Next: sign the device into a sandbox tester, then buy in Settings -> Paid Backend.")
  end

  desc "Build a signed paid-catalog acceptance IPA without enabling the repository default catalog"
  lane :paid_acceptance_archive do
    build_paid_acceptance
  end

  desc "Build and upload the paid-catalog acceptance candidate to TestFlight"
  lane :paid_acceptance_beta do
    key = app_store_connect_key
    version = get_version_number(
      xcodeproj: "OshiReader.xcodeproj",
      target: "OshiReader"
    )
    next_build_number = latest_testflight_build_number(
      api_key: key,
      app_identifier: "com.otterpia.oshireader",
      version: version,
      initial_build_number: 0
    ).to_i + 1
    ipa = build_paid_acceptance(build_number: next_build_number.to_s)
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
